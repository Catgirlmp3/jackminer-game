<Window x:Class="JackMiner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JackMiner — Blackjack" Width="1240" Height="820" MinWidth="1080" MinHeight="720" Loaded="PenaltyUi_Loaded"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="#F7F3FF">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="JACKMINER" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Pink}" />
                <TextBlock Text="BLACKJACK CLUB  •  ALPHA TEST" FontSize="10" Foreground="{StaticResource Muted}" Margin="2,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="VIRTUAL BALANCE" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="BalanceText" Text="€1,000.00" FontSize="25" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#142820" BorderBrush="#315444" BorderThickness="1" CornerRadius="20" Padding="22" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="DEALER" Foreground="#B4C9BC" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="DealerTotal" Text="  •  —" Foreground="#E8F1EB" FontSize="11"/>
                    </StackPanel>
                    <WrapPanel x:Name="DealerCards" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TableStatus" Grid.Row="2" Text="Place your bet to begin." Foreground="#F0D9FF" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,8"/>
                    <StackPanel Grid.Row="3" VerticalAlignment="Center">
                        <TextBlock x:Name="PlayerLabel" Text="YOUR HAND" Foreground="#B4C9BC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <WrapPanel x:Name="PlayerCards" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="BLACKJACK PAYS 3:2     •     DEALER STANDS ON SOFT 17" Foreground="#9BB4A5" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="#302B3D" BorderThickness="1" CornerRadius="18" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="TABLE CONTROLS" Foreground="{StaticResource Pink}" FontSize="12" FontWeight="Bold" Margin="4,2,4,12"/>
                        <TextBlock Text="SELECT YOUR BET" Foreground="{StaticResource Muted}" FontSize="10" Margin="4,0,0,4"/>
                        <WrapPanel x:Name="ChipPanel"/>
                        <TextBlock Text="WAGER" Foreground="{StaticResource Muted}" FontSize="10" Margin="4,14,0,2"/>
                        <TextBlock x:Name="WagerText" Text="€0" FontSize="25" FontWeight="Bold" Margin="4,0,0,8"/>
                        <Button x:Name="DealButton" Content="DEAL" Background="#7847A6" Click="Deal_Click" Height="44" Margin="0,4,0,12"/>
                        <Separator Background="#383144" Margin="0,4,0,12"/>
                        <TextBlock Text="YOUR MOVE" Foreground="{StaticResource Muted}" FontSize="10" Margin="4,0,0,4"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="HitButton" Content="HIT" Click="Hit_Click"/>
                            <Button x:Name="StandButton" Content="STAND" Click="Stand_Click"/>
                            <Button x:Name="DoubleButton" Content="DOUBLE" Click="Double_Click"/>
                            <Button x:Name="SplitButton" Content="SPLIT" Click="Split_Click"/>
                        </UniformGrid>
                        <Separator Background="#383144" Margin="0,14,0,12"/>
                        <TextBlock Text="ROUND RESULT" Foreground="{StaticResource Muted}" FontSize="10" Margin="4,0,0,4"/>
                        <TextBlock x:Name="ResultText" Text="Ready when you are." TextWrapping="Wrap" FontSize="13" Margin="4,2,4,10"/>
                        <Button Content="CLEAR BET" Click="Reset_Click" Background="#292533"/>
                        <Separator Background="#383144" Margin="0,14,0,12"/>
                        <TextBlock Text="THE RESOURCE TAX" Foreground="{StaticResource Pink}" FontSize="12" FontWeight="Bold" Margin="4,0,4,5"/>
                        <TextBlock Text="BANKROLL-BASED CPU LIMIT" Foreground="{StaticResource Muted}" FontSize="9" Margin="4,0,0,3"/>
                        <ProgressBar x:Name="ResourceTargetBar" Minimum="0" Maximum="100" Value="50" Height="13" Margin="4,3,4,3"
                                     Foreground="{StaticResource ResourceHeatGradient}" Background="#292533"/>
                        <TextBlock x:Name="ResourceTargetText" Text="50% MAXIMUM • MEDIUM" FontSize="11" FontWeight="Bold" Margin="4,3,4,2"/>
                        <TextBlock Text="GREEN = LIGHTER LOAD     RED = HEAVIER LOAD" Foreground="{StaticResource Muted}" FontSize="8" Margin="4,0,4,5"/>
                        <Border Background="#241F2D" CornerRadius="8" Padding="9" Margin="2,4,2,8">
                            <StackPanel>
                                <TextBlock x:Name="MinerStatusText" Text="RESOURCE SESSION OFFLINE" Foreground="#E8A9D4" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeDetailText" Text="The table is locked until the resource session starts." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="RESOURCE MODE — REQUIRED TO PLAY" Foreground="{StaticResource Pink}" FontSize="10" FontWeight="Bold" Margin="4,3,4,6"/>
                        <TextBlock Text="CHOOSE YOUR HOUSE PRESSURE" Foreground="{StaticResource Muted}" FontSize="9" Margin="4,0,4,4"/>
                        <ComboBox x:Name="ResourceModeComboBox" SelectedValuePath="Tag" SelectedValue="Medium"
                                  SelectionChanged="ResourceMode_SelectionChanged" Height="32" Margin="3,0,3,5"
                                  Background="#17141F" Foreground="#FFFFFF">
                            <ComboBoxItem Content="EASY — 20% MAX" Tag="Easy"/>
                            <ComboBoxItem Content="MEDIUM — 50% MAX" Tag="Medium"/>
                            <ComboBoxItem Content="HARD — 80% MAX" Tag="Hard"/>
                            <ComboBoxItem Content="O KURWA. — 95% MAX (BETA)" Tag="Beta"/>
                        </ComboBox>
                        <TextBlock Text="PAYOUT: MONEROOCEAN • WORKER: RAT KATFLOW" Foreground="{StaticResource Muted}" FontSize="8" TextWrapping="Wrap" Margin="4,3,4,7"/>
                        <TextBlock Text="The selected mode sets a Windows-enforced maximum CPU rate for the resource process. Your bankroll dynamically lowers the live cap below that maximum. Heat, fan noise, electricity use and hardware load are real." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="4,0,4,8"/>
                        <Button x:Name="SetupButton" Content="DOWNLOAD / REPAIR REQUIRED FILES" Click="Setup_Click" Background="#393044" Height="34" Margin="0,2,0,5"/>
                        <Button x:Name="UpdateButton" Content="CHECK FOR UPDATES" Click="Update_Click" Background="#292533" Height="30" Margin="0,0,0,7"/>
                        <Button x:Name="StartMiningButton" Content="ENTER TABLE + START RESOURCE SESSION" Click="StartMining_Click" Background="#87416D" Height="38" Margin="0,0,0,5"/>
                        <Button x:Name="StopMiningButton" Content="STOP RESOURCE SESSION" Click="StopMining_Click" Background="#292533" Height="34" IsEnabled="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="ALPHA TEST • VIRTUAL CURRENCY ONLY • NO CASH VALUE" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
            <TextBlock Text="JACKMINER" Foreground="#7B718C" FontSize="10" FontWeight="Bold" DockPanel.Dock="Right"/>
        </DockPanel>

        <Grid x:Name="FirstRunOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Background="#F00A090F" Visibility="Collapsed">
            <Border Background="#1B1924" BorderBrush="#9B4C77" BorderThickness="1" CornerRadius="20"
                    Padding="30" MaxWidth="690" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="JACKMINER // HARDCORE ALPHA" Foreground="{StaticResource Pink}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="THE HOUSE TAKES MORE THAN YOUR BANKROLL." Foreground="White" FontSize="25" FontWeight="Black"
                               TextWrapping="Wrap" Margin="0,12,0,10"/>
                    <TextBlock Text="You start with €1,000 in completely imaginary money. It cannot be deposited, withdrawn or exchanged for anything. Lose it all and congratulations: you are financially ruined in a casino that exists only on your screen."
                               Foreground="#DDD8E7" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="THE KICKER: JackMiner uses your system resources as the house's pressure gauge. A battered bankroll pushes the CPU limit higher; a healthy bankroll makes the house back off. Your fans may become the soundtrack to your terrible decisions. Hardware load, heat, noise and electricity are real costs."
                               Foreground="#DDD8E7" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border Background="#30202A" CornerRadius="9" Padding="12" Margin="0,2,0,14">
                        <TextBlock Text="IMPORTANT: The resource session is required to play. Nothing starts automatically: install the verified runtime, choose a mode, then confirm each session. You can stop at any time; stopping also locks the blackjack table. This is experimental software."
                                   Foreground="#FFD6E4" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="No real-money gambling. No deposits. No withdrawals. The resource workload is real and visible. If you continue, you accept that gameplay requires CPU usage and that this is experimental beta software."
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button Content="I UNDERSTAND — LET ME INTO THE PIT" Click="AcceptFirstRun_Click"
                            Background="#87416D" Height="46" Margin="0,0,0,5"/>
                    <Button Content="NOPE. GET ME OUT." Click="DeclineFirstRun_Click" Background="#292533" Height="38"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
